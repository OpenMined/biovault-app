{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/modules/expo-bioscript": ["./src/lab/desktop-expo-bioscript.ts"],
      "@/modules/expo-bioscript/*": ["./src/lab/desktop-expo-bioscript.ts"],
      "@/lib/lab/adapters/file-adapter.web": ["./src/lab/web-file-adapter.ts"],
      "@/lib/lab/adapters/file-picker": ["./src/lab/web-file-picker.ts"],
      "@/lib/lab/runtime-root": ["./src/lab/runtime-root.ts"],
      "@/lib/lab/generated-index-cache": ["./src/shims/generated-index-cache.ts"],
      "@/lib/lab/assay-registry": ["./src/shims/lab-assay-registry.ts"],
      "@/lib/remote-lab-file": ["./src/lab/remote-lab-file.ts"],
      "@/lib/app-db": ["./src/shims/app-db.ts"],
      "@/lib/assay-package-url-registry": ["./src/shims/assay-package-url-registry.ts"],
      "@/lib/remote-resource-cache": ["./src/shims/remote-resource-cache.ts"],
      "@/lib/clear-app-storage": ["./src/shims/clear-app-storage.ts"],
      "@/lib/browser-support": ["./src/shims/browser-support.ts"],
      "@react-native-async-storage/async-storage": ["./src/shims/async-storage.ts"],
      "@react-navigation/native": ["./src/shims/react-navigation-native.ts"],
      "react-native-safe-area-context": ["./src/shims/react-native-safe-area-context.tsx"],
      "expo-sqlite": ["./src/shims/expo-sqlite.ts"],
      "expo-asset": ["./src/shims/expo-asset.ts"],
      "expo-constants": ["./src/shims/expo-constants.ts"],
      "expo-device": ["./src/shims/expo-device.ts"],
      "expo-notifications": ["./src/shims/expo-notifications.ts"],
      "expo-file-system": ["./src/shims/expo-file-system.ts"],
      "expo-file-system/legacy": ["./src/shims/expo-file-system.ts"],
      "react-native-svg": ["./src/shims/react-native-svg.tsx"],
      "@/*": ["../*"],
      "@biovault/protocol": ["../packages/protocol/src"],
      "@biovault/ui-core": ["../packages/ui-core/src"]
    }
  },
  "include": ["src", "../packages/protocol/src", "../packages/ui-core/src"]
}
