# Files to exclude from EAS upload
# Docs: https://docs.expo.dev/eas/application-submissions/eas-json/#easignore

# VCS
.git/
.gitignore

# Dependency directories
node_modules/
.npm/
.pnpm-store/
.bun/

# Build and cache outputs
dist/
web-build/
build/
.expo/
.expo-shared/
.cache/
.tmp/
.temp/
coverage/
expo-env.d.ts
*.tsbuildinfo
*.map

# Native project directories (managed workflow - root level only)
/ios/
/android/
.gradle/
.kotlin/
Pods/
DerivedData/
*.xcworkspace
*.xcodeproj
*.xcuserdata/
*.xcuserstate
*.orig.*
.metro-health-check*

# Rust build artifacts
biovault_rust_lib/target/
**/target/

# Lockfiles
yarn.lock
pnpm-lock.yaml
bun.lockb
bun.lock

# Credentials and sensitive files
*.jks
*.keystore
*.keystore.properties
*.p8
*.p12
*.key
*.mobileprovision
.env
.env.*
.envrc
google-services.json
GoogleService-Info.plist

# Tests and non-essential project files
__tests__/
**/*.test.*
**/*.spec.*
jest-html-reporters-*
.github/
.husky/
storybook/
examples/

# Editor/OS detritus
.DS_Store
Thumbs.db
.vscode/
.idea/
.cursor/
*.iml
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.trace
*.stackdump
*.swp
*.swo
*.pem

# Large binary artifacts and archives
*.iso
*.dmg
*.zip
*.tar
*.gz
*.apk
*.aab
*.ipa
*.a

# Repo-specific files not needed for remote builds
/test-data/
app-example
notebooks/.ipynb_checkpoints/
notebooks/downloads/
notebooks/work/
output/
.claude/*
data/*
modules/expo-monty/android/src/main/jniLibs/
modules/expo-monty/android/build/
modules/expo-biovault/android/build/

brand.openmined.org/
