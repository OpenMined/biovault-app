{
  "name": "biovault-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=23.6.1",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "APP_VARIANT=development npx expo run:ios --device",
	"dev-android": "APP_VARIANT=development npx expo run:android --device",
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "prebuild": "npx expo prebuild --platform all --clean",
    "build-dev": "npx eas build --profile development --platform ios --local --clear-cache",
    "build-dev-android": "npx eas build --profile development --platform android --local --clear-cache",
    "build-prod": "npx eas build --profile production --platform ios --local --clear-cache",
    "build-preview-android": "npx eas build --profile preview --platform android --local --clear-cache",
    "deploy-preview-android": "npx eas build --profile preview --platform android --clear-cache",
    "deploy-dev": "npx eas build --profile development --platform ios --clear-cache",
    "deploy-dev-all": "npx eas build --profile development --platform all --clear-cache",
    "deploy-dev-android": "npx eas build --profile development --platform android --clear-cache",
    "deploy-prod": "npx eas build --profile production --platform ios --auto-submit --clear-cache",
    "deploy-prod-android": "npx eas build --profile production --platform android --auto-submit --clear-cache",
    "cargo-android": "sh ./modules/expo-biovault/scripts/build-rust-android.sh",
    "cargo-ios": "sh ./modules/expo-biovault/scripts/build-rust-ios.sh",
    "device": "npx expo run:ios --device"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.9",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.13",
    "expo-asset": "~55.0.14",
    "expo-constants": "~55.0.13",
    "expo-dev-client": "~55.0.24",
    "expo-device": "~55.0.14",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.16",
    "expo-font": "~55.0.6",
    "expo-linking": "~55.0.12",
    "expo-router": "~55.0.11",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.17",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-web-browser": "~55.0.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
